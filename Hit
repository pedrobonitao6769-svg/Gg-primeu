-- FUNÇÃO FLING COM RETORNO PARA A POSIÇÃO ORIGINAL DE ATIVAÇÃO
local function executarFling(alvo)
    if not alvo or not alvo.Character then return end

    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- 🌟 CHAVE DO FIX: Salva o local exato onde você estava antes de iniciar o ataque
    local posicaoOriginal = hrp.CFrame
    local startTime = tick()

    -- Força colisão massiva e física no início
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.Massless = false
        end
    end

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not alvo or not alvo.Character then return end
        if not hrp or not hrp.Parent then return end

        local targetChar = alvo.Character
        local torso = targetChar:FindFirstChild("UpperTorso") 
            or targetChar:FindFirstChild("Torso") 
            or targetChar:FindFirstChild("HumanoidRootPart")

        if not torso then return end

        -- Força a engine física a registrar colisão rígida em tempo real
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.Massless = false
            end
        end

        for _, part in ipairs(targetChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.Massless = false
            end
        end

        -- Cálculos de Predição e CFrame com micro-offsets caóticos
        local velocity = torso.AssemblyLinearVelocity
        local predict = velocity * 0.09

        local dist = (hrp.Position - torso.Position).Magnitude
        local offset = dist > 5 and 0.15 or 0.35

        hrp.CFrame = CFrame.new(torso.Position + predict)
            * CFrame.Angles(
                math.rad(math.random(-360,360)),
                math.rad(math.random(-360,360)),
                math.rad(math.random(-360,360))
            )
            * CFrame.new(
                math.random(-offset, offset),
                math.random(0, 1.2),
                math.random(-offset, offset)
            )

        -- ESCALONAMENTO DE FORÇA BRUTA (Para isolar o alvo do mapa)
        local force = dist > 6 and 850 or 1200

        hrp.AssemblyLinearVelocity = velocity + Vector3.new(
            math.random(-force, force),
            force * 2.5, -- Multiplicador vertical violento para arremessar por cima das barreiras do mapa
            math.random(-force, force)
        )

        -- AJUSTE DE ROTAÇÃO SOLICITADO: Travado estritamente em 8350 no eixo de torque principal
        hrp.AssemblyAngularVelocity = Vector3.new(
            math.random(-4500, 4500),
            8350, 
            math.random(-4500, 4500)
        )
    end)

    -- Mantém o loop destrutivo por 1.85 segundos
    while tick() - startTime < 1.85 do
        task.wait()
    end

    if conn then
        conn:Disconnect()
    end

    -- Limpa as velocidades angulares residuais imediatamente
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    task.wait(0.1)

    -- ⚡ LÓGICA DO RETORNO DE 2MS ATUALIZADA (Volta para onde você ativou o comando)
    -- Primeiro Teleporte de Retorno
    hrp.CFrame = posicaoOriginal
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    
    task.wait(0.002) -- Espera precisa de 2 milissegundos aplicada aqui
    
    -- Segundo Teleporte de Estabilização Completa no ponto de origem
    hrp.CFrame = posicaoOriginal
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    Fluent:Notify({ Title = "Super Fling Concluído", Content = "Alvo arremessado! Você retornou ao seu local original de partida." })
end

