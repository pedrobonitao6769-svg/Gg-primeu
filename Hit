local aiming, holding, aimConnection = false, false, nil
local FOV, SMOOTH, PREDICTION = 120, 0.15, 0.12
local camera = workspace.CurrentCamera

local circle = Drawing.new("Circle")
circle.Visible = false; circle.Color = Color3.fromRGB(255,255,255); circle.Thickness = 1; circle.NumSides = 100; circle.Radius = FOV; circle.Filled = false

RunService.RenderStepped:Connect(function() circle.Position = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2) end)
game:GetService("UserInputService").InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then holding = true end end)
game:GetService("UserInputService").InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then holding = false end end)

local function getTarget()
    local closest, shortest = nil, math.huge
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("Head") then
            local pos, onScreen = camera:WorldToViewportPoint(v.Character.Head.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - circle.Position).Magnitude
                if dist < FOV and dist < shortest then shortest = dist; closest = v end
            end
        end
    end
    return closest
end

Tabs.Xerife:AddToggle("aim legit", {
    Title = "Aim Legit Pro+", Description = "Aim com FOV + Smooth + Predição", Default = false,
    Callback = function(state)
        aiming = state; circle.Visible = state
        if state then
            aimConnection = RunService.RenderStepped:Connect(function()
                if aiming and holding then
                    local t = getTarget()
                    if t and t.Character and t.Character:FindFirstChild("Head") and t.Character:FindFirstChild("HumanoidRootPart") then
                        local velocity = t.Character.HumanoidRootPart.Velocity
                        local predPos = t.Character.Head.Position + (velocity * PREDICTION)
                        camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, predPos), SMOOTH)
                    end
                end
            end)
        else
            if aimConnection then aimConnection:Disconnect(); aimConnection = nil end
        end
    end 
})

