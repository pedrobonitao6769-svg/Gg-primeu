            elseif espHero and (char:FindFirstChild("Gun") or p.Backpack:FindFirstChild("Gun")) and p ~= sheriffOriginal then
                color = Color3.fromRGB(255, 255, 0)
                habilitado = true
            elseif espInnocent and not (char:FindFirstChild("Knife") or p.Backpack:FindFirstChild("Knife") or char:FindFirstChild("Gun") or p.Backpack:FindFirstChild("Gun")) then
                color = Color3.fromRGB(0, 255, 0)
